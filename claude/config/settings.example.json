{
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/session-intent.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/pre-push-guard.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "other-ninety@other-ninety": true
  },
  "extraKnownMarketplaces": {
    "other-ninety": {
      "source": {
        "source": "github",
        "repo": "vrennat/other-ninety"
      }
    }
  }
}
