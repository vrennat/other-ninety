{
  "name": "other-ninety-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test extensions tests",
    "check:model-policy": "bun scripts/check-model-policy.ts",
    "verify": "bun run check && bun run test",
    "update:pi": "bun update @earendil-works/pi-coding-agent@latest && bun run verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "chrome-devtools-mcp": "1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/bun": "1.2.22",
    "@types/node": "24.10.1",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
